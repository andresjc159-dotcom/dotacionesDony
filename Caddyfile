# Caddy — proxy inverso con HTTPS automático (certificado gratis vía Let's Encrypt).
# Cambia la línea de abajo por TU dominio gratis:
#   - DuckDNS:   tudominio.duckdns.org        (recomendado, elige un nombre)
#   - sslip.io:  54.210.15.44.sslip.io        (instantáneo, sin registro)
# Caddy obtiene y renueva el certificado HTTPS automáticamente.

tudominio.duckdns.org {
	encode gzip zstd
	reverse_proxy lb:80
}
