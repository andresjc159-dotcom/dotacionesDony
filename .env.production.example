# ============================================================
# Dotaciones Dony — Variables de entorno para PRODUCCIÓN (AWS)
# Copia este archivo a .env.production y completa los valores.
# ============================================================

DJANGO_SETTINGS_MODULE=config.settings.prod

# Genera una clave aleatoria: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CAMBIA-ESTE-VALOR

DEBUG=False
# Dominios permitidos, separados por comas. Para despliegue HTTP simple usa TU_IP,localhost
ALLOWED_HOSTS=tu-ip-o-dominio.com,localhost

# HTTPS. Para despliegue de prueba (HTTP sin dominio) usa False en las tres.
# Cuando tengas dominio + Caddy/HTTPS, ponlas en True.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ------------------------------------------------------------
# Base de datos (contenedor PostgreSQL dentro de la EC2)
# ------------------------------------------------------------
POSTGRES_DB=dotaciones_dony
POSTGRES_USER=dony
POSTGRES_PASSWORD=CONTRASENA_FUERTE
# Solo si usas RDS en lugar del contenedor (docker-compose.prod.yml):
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ------------------------------------------------------------
# Redis / Celery
# ------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------
# Correo (Amazon SES o SMTP)
# ------------------------------------------------------------
DEFAULT_FROM_EMAIL=Dotaciones Dony <no-reply@tudominio.com>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=TU_SMTP_USER
EMAIL_HOST_PASSWORD=TU_SMTP_PASSWORD
EMAIL_USE_TLS=True

# ------------------------------------------------------------
# Pasarela de pagos Wompi
# ------------------------------------------------------------
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_SANDBOX=False
